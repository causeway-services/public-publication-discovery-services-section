{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://561.group/schemas/publication-discovery-observation.v1.json",
  "title": "561 Publication Discovery Observation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "publication",
    "surface",
    "surfaceMode",
    "observedAt",
    "locale",
    "query",
    "intent",
    "entityResolution",
    "retrieved",
    "mentioned",
    "cited",
    "factuality",
    "evidence"
  ],
  "properties": {
    "publication": {
      "type": "string",
      "minLength": 1
    },
    "surface": {
      "type": "string",
      "minLength": 1
    },
    "surfaceMode": {
      "type": "string",
      "minLength": 1
    },
    "observedAt": {
      "type": "string",
      "format": "date-time"
    },
    "locale": {
      "type": "string",
      "minLength": 2
    },
    "query": {
      "type": "string",
      "minLength": 1
    },
    "intent": {
      "type": "string",
      "minLength": 1
    },
    "topic": {
      "type": [
        "string",
        "null"
      ]
    },
    "entityResolution": {
      "enum": [
        "exact",
        "ambiguous",
        "wrong-entity",
        "missing",
        "unknown"
      ]
    },
    "retrieved": {
      "type": [
        "boolean",
        "null"
      ],
      "description": "Observed retrieval when known; null means the answer engine's retrieval was not independently observable. Do not infer this from citations or brand mentions."
    },
    "mentioned": {
      "type": "boolean"
    },
    "cited": {
      "type": "boolean"
    },
    "citationUrls": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri"
      },
      "uniqueItems": true
    },
    "prominence": {
      "enum": [
        "primary",
        "prominent",
        "present",
        "incidental",
        "absent",
        "unknown"
      ]
    },
    "factuality": {
      "enum": [
        "accurate",
        "partly-accurate",
        "materially-wrong",
        "not-applicable",
        "unknown"
      ]
    },
    "factualityNotes": {
      "type": [
        "string",
        "null"
      ]
    },
    "freshness": {
      "enum": [
        "current",
        "stale",
        "not-applicable",
        "unknown"
      ]
    },
    "referralObserved": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "conversionObserved": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "value"
        ],
        "properties": {
          "kind": {
            "enum": [
              "url",
              "citation",
              "screenshot-ref",
              "provider-export-ref",
              "note"
            ]
          },
          "value": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
